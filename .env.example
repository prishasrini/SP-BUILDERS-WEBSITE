# Current WhatsApp-link website needs no sending-service credentials. Only the site URL below is used for SEO.
# Set the real HTTPS domain before deployment; omitted means no canonical URL.
NEXT_PUBLIC_SITE_URL=
# Server only. Create tables with supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret for hashing rate-limit keys (minimum 32 characters).
CONTACT_RATE_LIMIT_SECRET=

# Automatic notifications: server-only credentials, never NEXT_PUBLIC_.
RESEND_API_KEY=
# An address on a domain you verify in Resend, not the recipient's Gmail address.
ENQUIRY_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Approved WhatsApp sender; different from the recipient +919841145873.
TWILIO_WHATSAPP_FROM=
# Approved five-variable notification template, HX... (see docs/ENQUIRY-SETUP.md).
TWILIO_CONTENT_SID=

